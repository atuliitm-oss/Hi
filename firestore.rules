rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Student Blueprint
    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'rollNumber', 'creatorId', 'createdAt']) &&
             data.keys().size() >= 4 && data.keys().size() <= 12 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.rollNumber is string && data.rollNumber.size() > 0 && data.rollNumber.size() <= 100 &&
             data.creatorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    // Document Blueprint
    function isValidDocument(data) {
      return data.keys().hasAll(['studentId', 'creatorId', 'type', 'imageData', 'createdAt']) &&
             data.keys().size() >= 5 && data.keys().size() <= 15 &&
             data.studentId is string &&
             data.creatorId == request.auth.uid &&
             data.type is string && 
             data.imageData is string && data.imageData.size() < 1048576 &&
             data.createdAt == request.time;
    }

    // Pillar 1: The Master Gate (Relational Sync)
    
    // Students Collection
    match /students/{studentId} {
      allow create: if isVerified() && isValidStudent(incoming());
      
      // Allow read if user is the creator
      allow read: if isVerified() && existing().creatorId == request.auth.uid;

      allow update: if isVerified() && 
                    existing().creatorId == request.auth.uid &&
                    isValidStudent(incoming()) &&
                    incoming().creatorId == existing().creatorId;

      allow delete: if isVerified() && existing().creatorId == request.auth.uid;

      // Sub-collection: Documents
      match /documents/{docId} {
        // Pillar 8: Secure List Queries (No get() inside list for performance)
        allow list: if isVerified() && (
          (resource.data.creatorId == request.auth.uid) ||
          // Fallback for legacy documents: Only use get() if creatorId is missing from data
          (!("creatorId" in resource.data) && get(/databases/$(database)/documents/students/$(studentId)).data.creatorId == request.auth.uid)
        );

        // Pillar 1: Master Gate for single-document read
        allow get: if isVerified() && (
          (resource.data.creatorId == request.auth.uid) ||
          (get(/databases/$(database)/documents/students/$(studentId)).data.creatorId == request.auth.uid)
        );

        allow create: if isVerified() && 
                      isValidDocument(incoming()) &&
                      incoming().studentId == studentId &&
                      get(/databases/$(database)/documents/students/$(studentId)).data.creatorId == request.auth.uid;

        allow delete: if isVerified() && (
          (resource.data.creatorId == request.auth.uid) ||
          get(/databases/$(database)/documents/students/$(studentId)).data.creatorId == request.auth.uid
        );
      }
    }
  }
}
